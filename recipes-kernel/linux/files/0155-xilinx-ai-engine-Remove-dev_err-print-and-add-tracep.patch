From f176dfd667328314d7c452a91bb3170a53cb2505 Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:12:02 -0700
Subject: [PATCH 155/190] xilinx-ai-engine: Remove dev_err print and add
 tracepoint for hw err

commit d0bc7778486d6173f252831f7e54436e9b9042cc from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

It is possible to get interrupt while partition is not active. This is
not an error. Remove unnecessary error print for partition inactive.

Add trace point for hw error status.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-16-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 .../misc/xilinx-ai-engine/ai-engine-interrupt.c    |  5 ++---
 drivers/misc/xilinx-ai-engine/ai-engine-trace.h    | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-interrupt.c b/drivers/misc/xilinx-ai-engine/ai-engine-interrupt.c
index 1c1f291cecb6..c313f72a8962 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-interrupt.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-interrupt.c
@@ -1127,6 +1127,7 @@ static irqreturn_t aie2ps_hw_err(struct aie_aperture *aperture)
 		status = aie_aperture_get_hw_err_status(aperture, &loc);
 		if (status) {
 			handled = IRQ_HANDLED;
+			trace_aie_hw_err(loc.col, status);
 			dev_err(&aperture->dev, "Received Hw err: 0x%x on col: %d",
 				status, loc.col);
 			ret = aie_aperture_clr_hw_err(aperture, &loc, (u16)status);
@@ -1176,10 +1177,8 @@ irqreturn_t aie2ps_interrupt_user_event1(int irq, void *data)
 	trace_aie2ps_interrupt_user_event1(apart);
 	aperture = apart->aperture;
 	mutex_lock(&apart->mlock);
-	if (!apart->status) {
-		dev_err_ratelimited(&apart->dev, "USER_EVENT1 ISR: apart not active");
+	if (!apart->status)
 		goto out;
-	}
 	if (apart->range.size.col < 2) {
 		dev_err_ratelimited(&apart->adev->dev, "Cannot have partition with less than 2 cols.");
 		goto out;
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
index 3f88d39b7249..cffdb4fa0ddc 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
@@ -925,6 +925,20 @@ TRACE_EVENT(aie_partition_get_fd,
 		  __entry->partition_id, __entry->start_col, __entry->num_cols)
 );
 
+TRACE_EVENT(aie_hw_err,
+	TP_PROTO(int col, int err),
+	TP_ARGS(col, err),
+	TP_STRUCT__entry(
+		__field(int, col)
+		__field(int, err)
+	),
+	TP_fast_assign(
+		__entry->col = col;
+		__entry->err = err;
+	),
+	TP_printk("Received Hw error: err: 0x%x on col: %d", __entry->err, __entry->col)
+);
+
 #endif /* _AI_ENGINE_TRACE_H_ */
 
 #undef TRACE_INCLUDE_PATH
-- 
2.43.0

