From f542042cbab50016dd28e0ffd7a73bd907cdef69 Mon Sep 17 00:00:00 2001
From: Anish Kadamathikuttiyil Karthikeyan Pillai
 <anish.kadamathikuttiyil-karthikeyan-pillai@amd.com>
Date: Tue, 23 Sep 2025 09:30:16 +0100
Subject: [PATCH 133/190] arm64: versal: update thermal sensor and node

commit 31a995a636bd175d61b2431f7d61c93e26f635a5 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Update the device tree to integrate the enhanced thermal
monitoring capability for the AI Engine.

A new thermal zone to monitor the AI Engine specifically is
added along with the existing thermal zone, with two trip info.

Signed-off-by: Anish Kadamathikuttiyil Karthikeyan Pillai <anish.kadamathikuttiyil-karthikeyan-pillai@amd.com>
Message-ID: <20250923083019.2274145-2-anish.kadamathikuttiyil-karthikeyan-pillai@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 arch/arm64/boot/dts/xilinx/versal.dtsi | 33 ++++++++++++++++++++++----
 1 file changed, 29 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/xilinx/versal.dtsi b/arch/arm64/boot/dts/xilinx/versal.dtsi
index 1303ec916206..2b06ef9f486c 100644
--- a/arch/arm64/boot/dts/xilinx/versal.dtsi
+++ b/arch/arm64/boot/dts/xilinx/versal.dtsi
@@ -155,8 +155,8 @@ versal_fpga: versal-fpga {
 
 	sensor0: versal-thermal-sensor {
 		compatible = "xlnx,versal-thermal";
-		#thermal-sensor-cells = <0>;
-		io-channels = <&sysmon0>;
+		#thermal-sensor-cells = <1>;
+		io-channels = <&sysmon0 0>;
 		io-channel-names = "sysmon-temp-channel";
 	};
 
@@ -164,7 +164,7 @@ thermal-zones {
 		versal_thermal: versal-thermal {
 			polling-delay-passive = <250>; /* milliseconds */
 			polling-delay = <1000>; /* milliseconds */
-			thermal-sensors = <&sensor0>;
+			thermal-sensors = <&sensor0 0>;
 
 			trips {
 				temp_alert: temp-alert {
@@ -180,6 +180,28 @@ ot_crit: ot-crit {
 				};
 			};
 
+			cooling-maps {
+			};
+		};
+		versal_thermal_aie: versal-aie-thermal {
+			polling-delay-passive = <250>; /* milliseconds */
+			polling-delay = <1000>; /* milliseconds */
+			thermal-sensors = <&sensor0 1>;
+
+			trips {
+				temp_alert_aie: temp-alert-aie {
+					temperature = <70000>; /* millicelsius */
+					hysteresis = <0>; /* millicelsius */
+					type = "passive";
+				};
+
+				ot_crit_aie: ot-crit-aie {
+					temperature = <125000>; /* millicelsius */
+					hysteresis = <0>; /* millicelsius */
+					type = "critical";
+				};
+			};
+
 			cooling-maps {
 			};
 		};
@@ -578,12 +600,12 @@ spi1: spi@ff050000 {
 
 		sysmon0: sysmon@f1270000 {
 			compatible = "xlnx,versal-sysmon";
-			#io-channel-cells = <0>;
 			reg = <0x0 0xf1270000 0x0 0x4000>;
 			interrupts = <0 144 4>;
 			xlnx,numchannels = /bits/8 <0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			#io-channel-cells = <1>;
 		};
 
 		sysmon1: sysmon@109270000 {
@@ -593,6 +615,7 @@ sysmon1: sysmon@109270000 {
 			xlnx,numchannels = /bits/8 <0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			#io-channel-cells = <1>;
 		};
 
 		sysmon2: sysmon@111270000 {
@@ -602,6 +625,7 @@ sysmon2: sysmon@111270000 {
 			xlnx,numchannels = /bits/8 <0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			#io-channel-cells = <1>;
 		};
 
 		sysmon3: sysmon@119270000 {
@@ -611,6 +635,7 @@ sysmon3: sysmon@119270000 {
 			xlnx,numchannels = /bits/8 <0>;
 			#address-cells = <1>;
 			#size-cells = <0>;
+			#io-channel-cells = <1>;
 		};
 
 		ttc0: timer@ff0e0000 {
-- 
2.43.0

