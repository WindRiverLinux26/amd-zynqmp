From c45795748d95c707b2df362a1a0292d0b405db18 Mon Sep 17 00:00:00 2001
From: Amit Kumar Mahapatra <amit.kumar-mahapatra@amd.com>
Date: Thu, 9 Oct 2025 16:54:10 +0530
Subject: [PATCH 167/190] spi: spi-cadence: Enable SDR-PHY mode when
 spi-max-frequency is greater than 50 MHz

commit f71ef80a5255df080873a25cfd07a9eecb79ca34 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

With 'commit 9e279cdc5680 ("mtd: spi-nor: Add SDR-PHY support for OSPI
flashes")' and the broken-flash-reset property defined in the flash node,
the OSPI driver defaults to SDR-PHY mode. In this mode, the SPI bus
operates at the SPI reference clock frequency, which may exceed the maximum
supported SPI clock rate for certain OSPI flash devices in SDR mode. This
can result in bit-flips and introduce backward compatibility issues. Update
the driver to switch to SDR-PHY mode only if the spi-max-frequency is
greater than or equal to 50 MHz. Otherwise, operate in SDR-NON-PHY mode.

Fixes: 9e279cdc5680 ("mtd: spi-nor: Add SDR-PHY support for OSPI flashes")
Signed-off-by: Amit Kumar Mahapatra <amit.kumar-mahapatra@amd.com>
Message-ID: <20251009112411.3261192-2-amit.kumar-mahapatra@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/spi/spi-cadence-quadspi.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/spi/spi-cadence-quadspi.c b/drivers/spi/spi-cadence-quadspi.c
index 82af3421c7b0..8a8432a4eb40 100644
--- a/drivers/spi/spi-cadence-quadspi.c
+++ b/drivers/spi/spi-cadence-quadspi.c
@@ -52,6 +52,8 @@ static_assert(CQSPI_MAX_CHIPSELECT <= SPI_CS_CNT_MAX);
 /* Capabilities */
 #define CQSPI_SUPPORTS_OCTAL		BIT(0)
 
+#define CQSPI_SDR_MAX_FREQ		50000000 /* max supported freq. in SDR-NON-PHY mode */
+
 #define CQSPI_OP_WIDTH(part) ((part).nbytes ? ilog2((part).buswidth) : 0)
 
 enum {
@@ -1870,9 +1872,14 @@ static int cqspi_mem_process(struct spi_mem *mem, const struct spi_mem_op *op)
 {
 	struct cqspi_st *cqspi = spi_controller_get_devdata(mem->spi->controller);
 	struct cqspi_flash_pdata *f_pdata;
+	u32 speed_hz = mem->spi->max_speed_hz;
 
 	f_pdata = &cqspi->f_pdata[spi_get_chipselect(mem->spi, 0)];
-	cqspi_configure(f_pdata, mem->spi->max_speed_hz);
+
+	if (!f_pdata->cqspi->clk_tuned && mem->spi->max_speed_hz > CQSPI_SDR_MAX_FREQ)
+		speed_hz = CQSPI_SDR_MAX_FREQ;
+
+	cqspi_configure(f_pdata, speed_hz);
 
 	if (op->data.dir == SPI_MEM_DATA_IN && op->data.buf.in) {
 	/*
@@ -1920,7 +1927,8 @@ static int cqspi_exec_mem_op(struct spi_mem *mem, const struct spi_mem_op *op)
 		ret = cqspi_setup_edgemode(mem, op);
 		if (ret)
 			return ret;
-	} else if (mem->spi->controller->flags & SPI_CONTROLLER_SDR_PHY) {
+	} else if ((mem->spi->controller->flags & SPI_CONTROLLER_SDR_PHY) &&
+			(mem->spi->max_speed_hz >= CQSPI_SDR_MAX_FREQ)) {
 		ret = cqspi_setup_phymode(mem, op);
 		if (ret) {
 			f_pdata->dtr = false;
-- 
