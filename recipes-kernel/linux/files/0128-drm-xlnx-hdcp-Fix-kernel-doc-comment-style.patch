From fe0c43fc9d44358ee1c2dd7483fa9853e9430902 Mon Sep 17 00:00:00 2001
From: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Date: Wed, 24 Sep 2025 18:33:52 +0530
Subject: [PATCH 128/190] drm: xlnx: hdcp: Fix kernel-doc comment style

commit a2197012f8b79d30c5f016a08550e9b943f6318d from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Corrected comment blocks that incorrectly used '/**' without following
kernel-doc syntax. This resolves warnings from the kernel-doc checker
and aligns with documentation standards outlined in
Documentation/doc-guide/kernel-doc.rst.

Signed-off-by: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Message-ID: <1758719032-3989517-1-git-send-email-katta.dhanunjanrao@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/gpu/drm/xlnx/hdcp/xlnx_hdcp1x_tx.h | 61 ++++++++++++++++------
 1 file changed, 45 insertions(+), 16 deletions(-)

diff --git a/drivers/gpu/drm/xlnx/hdcp/xlnx_hdcp1x_tx.h b/drivers/gpu/drm/xlnx/hdcp/xlnx_hdcp1x_tx.h
index ddd32cd340d8..68cbd174a9cd 100644
--- a/drivers/gpu/drm/xlnx/hdcp/xlnx_hdcp1x_tx.h
+++ b/drivers/gpu/drm/xlnx/hdcp/xlnx_hdcp1x_tx.h
@@ -34,7 +34,8 @@
 #define XHDCP1X_TX_REVOCLIST_MAX_DEVICES	944
 #define XHDCP1X_TX_ENCRYPTION_KEY_SIZE		336
 #define XHDCP1X_PORT_MIN_BYTES 3
-/* These constants specify the offsets for the various fields and/or
+/*
+ * These constants specify the offsets for the various fields and/or
  * attributes within the hdcp port
  */
 #define XDPTX_HDCP1X_DPCD_OFFSET	0x68000
@@ -163,7 +164,7 @@
 #define XHDCP1X_TX_CLKDIV_MHZ			1000000
 #define XHDCP1X_TX_CLKDIV_HZ			1000
 
-/*
+/**
