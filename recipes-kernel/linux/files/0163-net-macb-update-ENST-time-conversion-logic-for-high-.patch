From 8299dea8babbbca2f98c0368444036f8ac645f91 Mon Sep 17 00:00:00 2001
From: Vineeth Karumanchi <vineeth.karumanchi@amd.com>
Date: Tue, 7 Oct 2025 14:58:40 +0530
Subject: [PATCH 163/190] net: macb: update ENST time conversion logic for
 high-speed links
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

commit 236ff76570a795b90fe310610ca86428fa5d14b2 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

- Revise the ENST time conversion to correctly handle 2.5G, 5G,
  and 10G link speeds, as shown below:

  Speed-specific divisors for nanosecond to hardware unit conversion:
    * 10  Mbps  →  /800
    * 100 Mbps  →  /80
    * ≥ 1 Gbps  →  /8

- Add likely() hints to optimize the common high-speed (≥ 1 Gbps) path.

These changes ensure accurate timing conversion in ENST configuration,
providing precise ON/OFF window duration across all supported link speeds.

Signed-off-by: Vineeth Karumanchi <vineeth.karumanchi@amd.com>
Message-ID: <20251007092840.1051088-1-vineeth.karumanchi@amd.com>
Reviewed-by: Harini Katakam <harini.katakam@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/net/ethernet/cadence/macb.h | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/cadence/macb.h b/drivers/net/ethernet/cadence/macb.h
index d01d60934378..01728cb1e4ed 100644
--- a/drivers/net/ethernet/cadence/macb.h
+++ b/drivers/net/ethernet/cadence/macb.h
@@ -1446,14 +1446,22 @@ static inline bool gem_has_ptp(struct macb *bp)
 /* ENST Helper functions */
 static inline u64 enst_ns_to_hw_units(size_t ns, u32 speed_mbps)
 {
+	if (likely(speed_mbps >= 1000))
+		return DIV_ROUND_UP(ns, ENST_TIME_GRANULARITY_NS);
+
 	return DIV_ROUND_UP((ns) * (speed_mbps),
 			    (ENST_TIME_GRANULARITY_NS * 1000));
 }
 
 static inline u64 enst_max_hw_interval(u32 speed_mbps)
 {
-	return DIV_ROUND_UP(GENMASK(GEM_ON_TIME_SIZE - 1, 0) *
-			    ENST_TIME_GRANULARITY_NS * 1000, (speed_mbps));
+	size_t base = (size_t)GENMASK(GEM_ON_TIME_SIZE - 1, 0) *
+			      ENST_TIME_GRANULARITY_NS;
+
+	if (likely(speed_mbps >= 1000))
+		return base;
+
+	return DIV_ROUND_UP(base * 1000, speed_mbps);
 }
 
