From bc63709bf2c97b51c1e8e5baf9bc9ce2c285845a Mon Sep 17 00:00:00 2001
From: Jay Buddhabhatti <jay.buddhabhatti@amd.com>
Date: Mon, 18 Aug 2025 04:59:00 -0700
Subject: [PATCH 034/190] drivers: firmware: xilinx: Move
 zynqmp_pm_get_family_info() to zynqmp-core.c

commit 889c9fc9178e0907f50cdb3e16846a6585bed8df from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

The zynqmp_pm_get_family_info() function is currently located in the
zynqmp-pm.c file, which does not have access to platform data. To
enable the use of platform data for distinguishing platforms via the
compatible string, this function is moved from zynqmp-pm.c to
zynqmp-core.c.

Signed-off-by: Jay Buddhabhatti <jay.buddhabhatti@amd.com>
State: not-upstreamable
Message-ID: <20250818115901.3692021-5-jay.buddhabhatti@amd.com>
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/firmware/xilinx/zynqmp-core.c | 36 +++++++++++++++++++++++++++
 drivers/firmware/xilinx/zynqmp-pm.c   | 36 ---------------------------
 2 files changed, 36 insertions(+), 36 deletions(-)

diff --git a/drivers/firmware/xilinx/zynqmp-core.c b/drivers/firmware/xilinx/zynqmp-core.c
index 6cdbebde0714..bccd6a3d87f2 100644
--- a/drivers/firmware/xilinx/zynqmp-core.c
+++ b/drivers/firmware/xilinx/zynqmp-core.c
@@ -770,6 +770,42 @@ static int get_set_conduit_method(struct device_node *np)
 	return 0;
 }
 
+/**
+ * zynqmp_pm_get_family_info() - Get family info of platform
+ * @family:	Returned family code value
+ * @subfamily:	Returned sub-family code value
+ *
+ * Return: Returns status, either success or error+reason
+ */
+int zynqmp_pm_get_family_info(u32 *family, u32 *subfamily)
+{
+	u32 ret_payload[PAYLOAD_ARG_CNT];
+	u32 idcode;
+	static u32 pm_family_code;
+	static u32 pm_sub_family_code;
+	int ret;
+
+	/* Check is family or sub-family code already received */
+	if (pm_family_code && pm_sub_family_code) {
+		*family = pm_family_code;
+		*subfamily = pm_sub_family_code;
+		return 0;
+	}
+
+	ret = zynqmp_pm_invoke_fn(PM_GET_CHIPID, ret_payload, 0);
+	if (ret < 0)
+		return ret;
+
+	idcode = ret_payload[1];
+	pm_family_code = FIELD_GET(FAMILY_CODE_MASK, idcode);
+	pm_sub_family_code = FIELD_GET(SUB_FAMILY_CODE_MASK, idcode);
+	*family = pm_family_code;
+	*subfamily = pm_sub_family_code;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zynqmp_pm_get_family_info);
+
 static int zynqmp_firmware_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
diff --git a/drivers/firmware/xilinx/zynqmp-pm.c b/drivers/firmware/xilinx/zynqmp-pm.c
index a5afc48c690b..b04241dab52d 100644
--- a/drivers/firmware/xilinx/zynqmp-pm.c
+++ b/drivers/firmware/xilinx/zynqmp-pm.c
@@ -102,42 +102,6 @@ int zynqmp_pm_get_chipid(u32 *idcode, u32 *version)
 }
 EXPORT_SYMBOL_GPL(zynqmp_pm_get_chipid);
 
