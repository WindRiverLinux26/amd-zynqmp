From 3166da79c0c83e45bbcd7b9a7eb2582800f4331c Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 6 Nov 2025 21:25:37 -0800
Subject: [PATCH 189/190] xilinx-ai-engine: switch to udelay for maskpoll

commit ad7e8ad83ca2834b6706ca866b34a5d9769fb0ee from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Partition initialize and teardown can be called by caller holding
spinlock, which disables preemption. Switch to udelay as usleep_range
cannot be used when preemption is disabled.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Message-ID: <20251107052538.1087250-4-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/misc/xilinx-ai-engine/ai-engine-part.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-part.c b/drivers/misc/xilinx-ai-engine/ai-engine-part.c
index 0b32f6b51238..2dfa7dbbc462 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-part.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-part.c
@@ -196,15 +196,14 @@ int aie_part_maskpoll_register(struct aie_partition *apart, u32 offset, u32 data
 			       u32 timeout)
 {
 	u32 value;
-	u32 min_usleep = 10;
-	u32 max_usleep = 20;
+	u32 usleep_time = 10;
 	u32 i;
 
-	for (i = 0; i < timeout; i += min_usleep) {
+	for (i = 0; i < timeout; i += usleep_time) {
 		value = ioread32(apart->aperture->base + offset);
 		if ((value & mask) == data)
 			return 0;
-		usleep_range(min_usleep, max_usleep);
+		udelay(usleep_time);
 	}
 
 	value = ioread32(apart->aperture->base + offset);
-- 
2.43.0

