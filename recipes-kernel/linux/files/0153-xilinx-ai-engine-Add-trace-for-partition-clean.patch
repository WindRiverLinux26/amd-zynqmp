From 5e4ba0a01023910a564a84a23240e56a8b8480d3 Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:12:00 -0700
Subject: [PATCH 153/190] xilinx-ai-engine: Add trace for partition clean

commit 95e2f2f21db0c447ce8497beb7679c37869f38ef from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Add tracepoint for aie_part_clean for aie and aie2ps device.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-14-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/misc/xilinx-ai-engine/ai-engine-reset.c |  2 ++
 drivers/misc/xilinx-ai-engine/ai-engine-trace.h | 17 +++++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-reset.c b/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
index 4bec6a480403..85956fd738ed 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
@@ -305,6 +305,7 @@ int aie2ps_part_clean(struct aie_partition *apart)
 	if (apart->cntrflag & XAIE_PART_NOT_RST_ON_RELEASE)
 		return 0;
 
+	trace_aie_part_clean(apart);
 	ret = aie_part_pm_ops(apart, NULL, AIE_PART_INIT_OPT_DIS_COLCLK_BUFF, apart->range, 1);
 	if (ret)
 		goto out;
@@ -356,6 +357,7 @@ int aie_part_clean(struct aie_partition *apart)
 	if (apart->cntrflag & XAIE_PART_NOT_RST_ON_RELEASE)
 		return 0;
 
+	trace_aie_part_clean(apart);
 	ret = zynqmp_pm_aie_operation(node_id, apart->range.start.col,
 				      apart->range.size.col,
 				      XILINX_AIE_OPS_DIS_COL_CLK_BUFF);
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
index 9eb414c76f5f..6ab0e7d5e62b 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
@@ -115,6 +115,23 @@ TRACE_EVENT(aie_part_release_tile,
 	TP_printk("id: %d  loc: [%d, %d]", __entry->partition_id, __entry->col, __entry->row)
 );
 
+TRACE_EVENT(aie_part_clean,
+	TP_PROTO(struct aie_partition *apart),
+	TP_ARGS(apart),
+	TP_STRUCT__entry(
+		__field(__u32, partition_id)
+		__field(__u32, start_col)
+		__field(__u32, num_cols)
+	),
+	TP_fast_assign(
+		__entry->partition_id = apart->partition_id;
+		__entry->start_col = apart->range.start.col;
+		__entry->num_cols = apart->range.size.col;
+	),
+	TP_printk("id: %d  start_col: %u num_cols: %u",
+		  __entry->partition_id, __entry->start_col, __entry->num_cols)
+);
+
 TRACE_EVENT(aie_part_set_column_clock_from_user,
 	TP_PROTO(struct aie_partition *apart, struct aie_column_args *args),
 	TP_ARGS(apart, args),
-- 
2.43.0

