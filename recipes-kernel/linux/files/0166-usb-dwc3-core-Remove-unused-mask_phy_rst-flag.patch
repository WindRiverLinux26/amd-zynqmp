From 634c3cab5b06239552f16cee8cf9de9288cf9b0a Mon Sep 17 00:00:00 2001
From: Radhey Shyam Pandey <radhey.shyam.pandey@amd.com>
Date: Thu, 9 Oct 2025 12:48:11 +0530
Subject: [PATCH 166/190] usb: dwc3: core: Remove unused mask_phy_rst flag

commit d34d36975e1b93962782e8cff60c079a7325a70b from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

The mask phy reset bit-field in struct dwc3 is no longer used anywhere in
the driver code. So remove this unused variable to fix below kernel-doc
warning.

drivers/usb/dwc3/core.h:1441: warning: Function parameter or struct
member 'mask_phy_rst' not described in 'dwc3'

Signed-off-by: Radhey Shyam Pandey <radhey.shyam.pandey@amd.com>
Message-ID: <20251009071811.1574563-4-radhey.shyam.pandey@amd.com>
State: not-upstreamable
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/usb/dwc3/core.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index a5585ffccc0d..c8869e73181a 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1425,7 +1425,6 @@ struct dwc3 {
 	unsigned		is_hibernated:1;
 
 	unsigned		dis_metastability_quirk:1;
-	unsigned		mask_phy_rst:1;
 
 	unsigned		dis_split_quirk:1;
 	unsigned		async_callbacks:1;
-- 
