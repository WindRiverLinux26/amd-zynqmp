From 80224d899062ce3edfb5aae9544e31730ea1a76b Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:11:58 -0700
Subject: [PATCH 151/190] uio_dmabuf: Fix dbuf_mem failure condition check

commit 02f06cb4e9540560197395307972990dd6bd74a5 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

In case dbuf_mem entry is not found, it is guaranteed to point to head.
Head is not part of any container_of. This causes pointer access to
wrong address. Check if dbuf_mem points to head in failure case.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-12-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/uio/uio_dmabuf.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/uio/uio_dmabuf.c b/drivers/uio/uio_dmabuf.c
index 86421c62bf27..3893ca5d8ac0 100644
--- a/drivers/uio/uio_dmabuf.c
+++ b/drivers/uio/uio_dmabuf.c
@@ -160,12 +160,13 @@ long uio_dmabuf_unmap(struct uio_device *dev, struct list_head *dbufs,
 			break;
 	}
 
-	if (dbuf_mem->dbuf_fd != args.dbuf_fd) {
+	if (list_entry_is_head(dbuf_mem, dbufs, list)) {
 		dev_err(dev->dev.parent, "failed to find the dmabuf (%d)\n",
 			args.dbuf_fd);
 		ret = -EINVAL;
 		goto err_unlock;
 	}
+
 	list_del(&dbuf_mem->list);
 	mutex_unlock(dbufs_lock);
 
-- 
