From cb736dc5c8d0e0667a3330b55d12fe8147e7c2c9 Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:11:49 -0700
Subject: [PATCH 142/190] xilinx-ai-engine: Fix invalid init_opts check

commit 2706f94a2a0732ff01d3b6d3113a63a885004978 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

opts is OR of all opts the driver recognized and performed. Check if
opts performed is equal to init_opts requested.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-3-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/misc/xilinx-ai-engine/ai-engine-reset.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-reset.c b/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
index 8e34a767d68a..6cb495fb7353 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-reset.c
@@ -875,7 +875,7 @@ int aie2ps_part_initialize(struct aie_partition *apart, struct aie_partition_ini
 	if (args->init_opts & AIE_PART_INIT_OPT_NMU_CONFIG) {
 		struct aie_range range = {0};
 
-		opts |= ~AIE_PART_INIT_OPT_NMU_CONFIG;
+		opts |= AIE_PART_INIT_OPT_NMU_CONFIG;
 		if (apart->range.start.col == 0) {
 			range.size.col = 2;
 			ret = aie_part_pm_ops(apart, NULL, AIE_PART_INIT_OPT_NMU_CONFIG, range, 0);
@@ -962,8 +962,8 @@ int aie2ps_part_initialize(struct aie_partition *apart, struct aie_partition_ini
 			goto out;
 	}
 
-	if (opts)
-		dev_warn(&apart->dev, "Invalid init_opts: 0x%x", opts);
+	if (opts != args->init_opts)
+		dev_warn(&apart->dev, "Invalid init_opts: 0x%x", opts ^ args->init_opts);
 
 out:
 	mutex_unlock(&apart->mlock);
-- 
