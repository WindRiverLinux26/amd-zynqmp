+              reg = <14>;
+              xlnx,name = "aie-temp-ch2";
+            };
+
+            temp@15 {
+              xlnx,aie-temp;
+              reg = <15>;
+              xlnx,name = "aie-temp-ch3";
+            };
+
+            temp@16 {
+              xlnx,aie-temp;
+              reg = <16>;
+              xlnx,name = "aie-temp-ch4";
+            };
+
+            temp@30 {
+              xlnx,aie-temp;
+              reg = <30>;
+              xlnx,name = "aie-temp-ch5";
+            };
+
+            temp@33 {
+              xlnx,aie-temp;
+              reg = <33>;
+              xlnx,name = "aie-temp-ch6";
+            };
+
+            temp@34 {
+              xlnx,aie-temp;
+              reg = <34>;
+              xlnx,name = "aie-temp-ch7";
+            };
         };
     };
