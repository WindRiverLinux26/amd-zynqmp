From 84fa0f7dd288226f182eba8b24579f7e596feb63 Mon Sep 17 00:00:00 2001
From: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Date: Wed, 23 Jul 2025 19:35:13 +0530
Subject: [PATCH 006/190] drm: mipi: Remove unused dt-bindings header for MIPI
 DSI

commit a8026666f0a593abdf99c3e5d5d7a8b305fbffa6 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Remove the inclusion of 'dt-bindings/drm/mipi-dsi.h' as
it is no longer used. The driver now relies on
'drm/drm_mipi_dsi.h' for format definitions and related
constants.

This cleanup avoids redundant headers and aligns with current usage.

Signed-off-by: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Message-ID: <1753279513-41379-1-git-send-email-katta.dhanunjanrao@amd.com>
State: not-upstreamable
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 include/dt-bindings/drm/mipi-dsi.h | 11 -----------
 1 file changed, 11 deletions(-)
 delete mode 100644 include/dt-bindings/drm/mipi-dsi.h

diff --git a/include/dt-bindings/drm/mipi-dsi.h b/include/dt-bindings/drm/mipi-dsi.h
deleted file mode 100644
index c6f37ec661fe..000000000000
--- a/include/dt-bindings/drm/mipi-dsi.h
+++ /dev/null
@@ -1,11 +0,0 @@
-#ifndef __DT_BINDINGS_DRM__
-#define __DT_BINDINGS_DRM__
-/*
- * MIPI DSI pixel formats as defined in the include/drm/drm_mipi_dsi.h"
- */
-#define MIPI_DSI_FMT_RGB888		0
-#define MIPI_DSI_FMT_RGB666		1
-#define MIPI_DSI_FMT_RGB666_PACKED	2
-#define MIPI_DSI_FMT_RGB565		3
-
-#endif /* _DT_BINDINGS_DRM__ */
-- 
