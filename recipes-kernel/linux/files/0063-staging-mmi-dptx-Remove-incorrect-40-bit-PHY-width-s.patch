From a99c8034b9a00c845b10a82e79dcfc07cb3638e3 Mon Sep 17 00:00:00 2001
From: Rohit Visavalia <rohit.visavalia@amd.com>
Date: Tue, 19 Aug 2025 05:25:01 -0700
Subject: [PATCH 063/190] staging: mmi-dptx: Remove incorrect 40-bit PHY width
 setting

commit 97d7649f4bed3f665799830fbbaf98ef1635d696 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

The MMI DP Tx IP uses a 20-bit PHY width. Setting it to 40 bits
is incorrect and unnecessary, so drop that configuration.

Signed-off-by: Rohit Visavalia <rohit.visavalia@amd.com>
Reviewed-by: Vishal Sagar <vishal.sagar@amd.com>
Reviewed-by: Anatoliy Klymenko <anatoliy.klymenko@amd.com>
Message-ID: <20250819122502.1030134-2-rohit.visavalia@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/staging/xlnx-mmi-dptx/mmi_dp.c | 18 +-----------------
 1 file changed, 1 insertion(+), 17 deletions(-)

diff --git a/drivers/staging/xlnx-mmi-dptx/mmi_dp.c b/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
index 827d4c2cb4f5..60929604828c 100644
--- a/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
+++ b/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
@@ -451,7 +451,7 @@ static void mmi_dp_soft_reset_all(struct dptx *dptx)
  */
 void mmi_dp_core_init_phy(struct dptx *dptx)
 {
-	mmi_dp_set(dptx->base, PHYIF_CTRL, PHYIF_PHY_WIDTH);
+	mmi_dp_clr(dptx->base, PHYIF_CTRL, PHYIF_PHY_WIDTH);
 }
 
 /**
@@ -615,22 +615,6 @@ void mmi_dp_phy_set_rate(struct dptx *dptx, unsigned int rate)
 {
 	dptx_dbg(dptx, "%s: rate=%d\n", __func__, rate);
 
-	switch (rate) {
-	case DPTX_PHYIF_CTRL_RATE_RBR:
-	case DPTX_PHYIF_CTRL_RATE_HBR:
-		/* Set 20-bit PHY width */
-		mmi_dp_clr(dptx->base, PHYIF_CTRL, PHYIF_PHY_WIDTH);
-		break;
-	case DPTX_PHYIF_CTRL_RATE_HBR2:
-	case DPTX_PHYIF_CTRL_RATE_HBR3:
-		/* Set 40-bit PHY width */
-		mmi_dp_set(dptx->base, PHYIF_CTRL, PHYIF_PHY_WIDTH);
-		break;
-	default:
-		dptx_warn(dptx, "Invalid PHY rate %d\n", rate);
-		break;
-	}
-
 	mmi_dp_write_mask(dptx, PHYIF_CTRL, PHYIF_PHY_RATE, rate);
 }
 
-- 
