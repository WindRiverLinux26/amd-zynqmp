From 0c4234634e19875adf19c9214c62a95d97e9cc99 Mon Sep 17 00:00:00 2001
From: Rohit Visavalia <rohit.visavalia@amd.com>
Date: Fri, 17 Oct 2025 02:32:11 -0700
Subject: [PATCH 172/190] staging: mmi-dptx: Determine valid modes based on
 trained link configuration

commit 0077ed515e0a8f8f6ba93bb16677e2523ab16610 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Valid display modes should be selected according to the current trained
link configuration, rather than relying on the maximum number of lanes and
link rate supported by the display controller.

Signed-off-by: Rohit Visavalia <rohit.visavalia@amd.com>
Reviewed-by: Vishal Sagar <vishal.sagar@amd.com>
Tested-by: Vishal Sagar <vishal.sagar@amd.com>
Message-ID: <20251017093211.627640-1-rohit.visavalia@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/staging/xlnx-mmi-dptx/mmi_dp.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/staging/xlnx-mmi-dptx/mmi_dp.c b/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
index 6c0e17be2a8b..22c0516c9370 100644
--- a/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
+++ b/drivers/staging/xlnx-mmi-dptx/mmi_dp.c
@@ -906,10 +906,10 @@ mmi_dp_bridge_mode_valid(struct drm_bridge *bridge,
 	dptx->bpp = mmi_dp_get_color_depth_bpp(dptx->vparams[0].bpc,
 					       dptx->vparams[0].pix_enc);
 
-	link_rate = mmi_dp_get_link_rate(dptx->max_rate);
+	link_rate = mmi_dp_get_link_rate(dptx->link.rate);
 	link_rate *= 1000;
 
-	max_pxl_clk = mmi_dp_max_rate(link_rate, dptx->max_lanes, dptx->bpp);
+	max_pxl_clk = mmi_dp_max_rate(link_rate, dptx->link.lanes, dptx->bpp);
 
 	dptx_dbg(dptx, "%s Bpp %d, link_rate %d pixel clock set %d\n", __func__,
 		 dptx->bpp, link_rate, max_pxl_clk);
-- 
