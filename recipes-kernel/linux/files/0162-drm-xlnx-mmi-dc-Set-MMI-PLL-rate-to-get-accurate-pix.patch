From de464641928acd83862e8d11ab1a444c0c35460e Mon Sep 17 00:00:00 2001
From: Rohit Visavalia <rohit.visavalia@amd.com>
Date: Mon, 6 Oct 2025 07:07:08 -0700
Subject: [PATCH 162/190] drm: xlnx: mmi-dc: Set MMI PLL rate to get accurate
 pixel clock

commit 0790afa81ad136aeb221366db0f7085525118abc from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

The MMI PLL is parent clock to aux0 and aux1 ref clocks. The aux0 and
aux1 ref clocks are required to be precise as they are the pixel clock and
audio video sync clock respectively.

If one of them is required to be changed, the MMI PLL currently doesn't
change, leading to inaccurate clocks getting generated.

Hence to get accurate clocks, the LCM of child clocks is calculated,
and the nearest value is set as parent MMI PLL clock to have least
deviation in the child clocks.

Signed-off-by: Rohit Visavalia <rohit.visavalia@amd.com>
Reviewed-by: Vishal Sagar <vishal.sagar@amd.com>
Reviewed-by: Anatoliy Klymenko <anatoliy.klymenko@amd.com>
Message-ID: <20251006140708.2782229-4-vishal.sagar@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/gpu/drm/xlnx/mmi_dc.c     |  3 ++
 drivers/gpu/drm/xlnx/mmi_dc.h     | 12 ++++++++
 drivers/gpu/drm/xlnx/mmi_dc_kms.c | 49 +++++++++++++++++++++++++++++++
 3 files changed, 64 insertions(+)

diff --git a/drivers/gpu/drm/xlnx/mmi_dc.c b/drivers/gpu/drm/xlnx/mmi_dc.c
index 924c75d861d9..fa96455eb257 100644
--- a/drivers/gpu/drm/xlnx/mmi_dc.c
+++ b/drivers/gpu/drm/xlnx/mmi_dc.c
@@ -444,6 +444,9 @@ int mmi_dc_init(struct mmi_dc *dc, struct drm_device *drm)
 		return -EINVAL;
 	}
 
+	dc->mmi_pll_clk = mmi_dc_init_clk(dc, "mmi_pll");
+	dc->stc_ref_clk = mmi_dc_init_clk(dc, "stc_ref_clk");
+
 	mmi_dc_reset_hw(dc);
 
 	dc_write_misc(dc, MMI_DC_MISC_WPROTS, 0);
diff --git a/drivers/gpu/drm/xlnx/mmi_dc.h b/drivers/gpu/drm/xlnx/mmi_dc.h
index ff9bd7a853cc..c22ce2e864e9 100644
--- a/drivers/gpu/drm/xlnx/mmi_dc.h
+++ b/drivers/gpu/drm/xlnx/mmi_dc.h
@@ -15,6 +15,14 @@
 #define MMI_DC_NUM_CC			(3)
 #define MMI_DC_CURSOR_WIDTH		(128)
 #define MMI_DC_CURSOR_HEIGHT		(128)
+#define MMI_DC_STC_CLK_RATE		(27000000U)
+/*
+ * The MMI PLL clock range is 187 MHz to 3 GHz.
+ * But only multiples of 27 MHz matter for AV Sync.
+ * So the range becomes 189 MHz (27 * 7) to 2.997 GHz (27 * 111).
+ */
+#define MMI_PLL_MIN_CLK_RATE		(MMI_DC_STC_CLK_RATE * 7)
+#define MMI_PLL_MAX_CLK_RATE		(MMI_DC_STC_CLK_RATE * 111)
 
 #define MMI_DC_AV_BUF_OUTPUT_AUDIO_VIDEO_SELECT		(0x0070)
 
@@ -67,6 +75,8 @@ struct mmi_audio;
  * @rst: external reset
  * @pl_pixel_clk: PL pixel clock pl_dc2x or pl_dc1x
  * @ps_pixel_clk: PS pixel clock mmi_aux0_ref_clk
+ * @mmi_pll_clk: parent to pixel clock
+ * @stc_ref_clk: 27Mhz DC reference clock for AV sync
  * @aud_clk: audio clock
  * @audio: Audio data
  * @irq_num: interrupt lane number
@@ -87,6 +97,8 @@ struct mmi_dc {
 	struct reset_control	*rst;
 	struct clk		*pl_pixel_clk;
 	struct clk		*ps_pixel_clk;
+	struct clk		*mmi_pll_clk;
+	struct clk		*stc_ref_clk;
 	struct clk		*aud_clk;
 	struct mmi_audio	*audio;
 	int			irq_num;
diff --git a/drivers/gpu/drm/xlnx/mmi_dc_kms.c b/drivers/gpu/drm/xlnx/mmi_dc_kms.c
index 46783f519903..cb78eb1cb5c9 100644
--- a/drivers/gpu/drm/xlnx/mmi_dc_kms.c
+++ b/drivers/gpu/drm/xlnx/mmi_dc_kms.c
@@ -122,6 +122,31 @@ static inline struct mmi_dc *crtc_to_dc(struct drm_crtc *crtc)
 	return container_of(crtc, struct mmi_dc_drm, crtc)->dc;
 }
 
+/**
+ * mmi_dc_cal_mmi_pll_rate - Find mmi pll clock rate in supported range
+ * @mode_clk: Video mode clock rate
+ *
+ * Return: Best MMI PLL rate within supported range
+ */
+static u32 mmi_dc_cal_mmi_pll_rate(u32 mode_clk)
+{
+	u32 lcm_val = 0;
+	u32 deviation = mode_clk;
+	u32 i, divisor, possible_mode_clk, diff;
+
+	for (i = MMI_PLL_MAX_CLK_RATE; i >= MMI_PLL_MIN_CLK_RATE && i >= mode_clk;
+	     i -= MMI_DC_STC_CLK_RATE) {
+		divisor = DIV_ROUND_CLOSEST(i, mode_clk);
+		possible_mode_clk = i / divisor;
+		diff = abs(mode_clk - possible_mode_clk);
+		if (diff < deviation) {
+			deviation = diff;
+			lcm_val = i;
+		}
+	}
+	return lcm_val;
+}
+
 /**
  * mmi_dc_drm_handle_vblank - Handle VBLANK notification
  * @drm: pointer to MMI DC DRM
@@ -164,10 +189,30 @@ static void mmi_dc_crtc_atomic_enable(struct drm_crtc *crtc,
 	struct mmi_dc *dc = crtc_to_dc(crtc);
 	struct drm_display_mode *adjusted_mode = &crtc->state->adjusted_mode;
 	unsigned long mode_clock = adjusted_mode->clock * 1000;
+	unsigned long mmi_pll_clock;
 	int vrefresh, ret = 0;
 
 	pm_runtime_get_sync(dc->dev);
 
+	if (dc->mmi_pll_clk) {
+		mmi_pll_clock = mmi_dc_cal_mmi_pll_rate(mode_clock);
+		if (!mmi_pll_clock) {
+			dev_err(dc->dev, "failed to get optimal MMI PLL clock rate\n");
+			return;
+		}
+		if (mmi_dc_set_clk(dc, dc->mmi_pll_clk, mmi_pll_clock)) {
+			dev_err(dc->dev, "failed to set MMI PLL clock!\n");
+			return;
+		}
+	}
+
+	if (dc->stc_ref_clk) {
+		if (mmi_dc_set_clk(dc, dc->stc_ref_clk, MMI_DC_STC_CLK_RATE)) {
+			dev_err(dc->dev, "failed to set STC REF clock!\n");
+			return;
+		}
+	}
+
 	if (dc->pl_pixel_clk)
 		ret |= mmi_dc_set_clk(dc, dc->pl_pixel_clk, mode_clock);
 
@@ -205,6 +250,10 @@ static void mmi_dc_crtc_atomic_disable(struct drm_crtc *crtc,
 		clk_disable_unprepare(dc->pl_pixel_clk);
 	if (dc->ps_pixel_clk)
 		clk_disable_unprepare(dc->ps_pixel_clk);
+	if (dc->stc_ref_clk)
+		clk_disable_unprepare(dc->stc_ref_clk);
+	if (dc->mmi_pll_clk)
+		clk_disable_unprepare(dc->mmi_pll_clk);
 
 	pm_runtime_put_sync(dc->dev);
 }
-- 
