From 896960e2196e11cb6f8cc80d5abe8b3458fe20f9 Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:11:52 -0700
Subject: [PATCH 145/190] xilinx-ai-engine: Add tracepoint for
 aie_part_release_device

commit b3ea3080346e40826688f057c3e3393d9f475549 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

aie_part_release_device() is release call back of struct device. Add
tracepoints.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-6-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 .../misc/xilinx-ai-engine/ai-engine-part.c    |  2 ++
 .../misc/xilinx-ai-engine/ai-engine-trace.h   | 34 +++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-part.c b/drivers/misc/xilinx-ai-engine/ai-engine-part.c
index ac3169d15489..085bfc8461f1 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-part.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-part.c
@@ -1008,6 +1008,7 @@ static void aie_part_release_device(struct device *dev)
 	struct aie_aperture *aperture = apart->aperture;
 	int ret;
 
+	trace_aie_part_release_device(apart);
 	ret = mutex_lock_interruptible(&aperture->mlock);
 	if (ret) {
 		dev_warn(&apart->dev,
@@ -1024,6 +1025,7 @@ static void aie_part_release_device(struct device *dev)
 	aie_part_rscmgr_finish(apart);
 	/* Check and set frequency requirement for aperture */
 	aie_part_set_freq(apart, 0);
+	trace_aie_part_release_device_done(apart);
 }
 
 /**
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
index 9afbdd8c5bbc..0b6b62718c00 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
@@ -714,6 +714,40 @@ TRACE_EVENT(aie_partition_release,
 		  __entry->partition_id, __entry->start_col, __entry->num_cols)
 );
 
+TRACE_EVENT(aie_part_release_device,
+	TP_PROTO(struct aie_partition *apart),
+	TP_ARGS(apart),
+	TP_STRUCT__entry(
+		__field(__u32, partition_id)
+		__field(__u32, start_col)
+		__field(__u32, num_cols)
+	),
+	TP_fast_assign(
+		__entry->partition_id = apart->partition_id;
+		__entry->start_col = aie_part_id_get_start_col(apart->partition_id);
+		__entry->num_cols = aie_part_id_get_num_cols(apart->partition_id);
+	),
+	TP_printk("id: %d start_col: %d num_cols: %d",
+		  __entry->partition_id, __entry->start_col, __entry->num_cols)
+);
+
+TRACE_EVENT(aie_part_release_device_done,
+	TP_PROTO(struct aie_partition *apart),
+	TP_ARGS(apart),
+	TP_STRUCT__entry(
+		__field(__u32, partition_id)
+		__field(__u32, start_col)
+		__field(__u32, num_cols)
+	),
+	TP_fast_assign(
+		__entry->partition_id = apart->partition_id;
+		__entry->start_col = aie_part_id_get_start_col(apart->partition_id);
+		__entry->num_cols = aie_part_id_get_num_cols(apart->partition_id);
+	),
+	TP_printk("id: %d start_col: %d num_cols: %d",
+		  __entry->partition_id, __entry->start_col, __entry->num_cols)
+);
+
 TRACE_EVENT(aie_partition_release_done,
 	TP_PROTO(struct aie_partition *apart),
 	TP_ARGS(apart),
-- 
2.43.0

