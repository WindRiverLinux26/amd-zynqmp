From 1e100b64ec1c2300e88bedc97bd3df4f06531e4c Mon Sep 17 00:00:00 2001
From: Abin Joseph <abin.joseph@amd.com>
Date: Sat, 16 Aug 2025 07:39:47 +0530
Subject: [PATCH 028/190] net: xilinx: axienet: Simplify gt_mode property check

commit 055d65f5800387beefee46cae667eec8358ff76f from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Fix the condition to check for successful return value which is clearer
since when of_property_read_string() returns 0, gt_mode is guaranteed to
be set to a valid string.

Fixes: a3f3ca267fc8 ("net: axienet: Add support for MRMAC GT narrow mode")
Signed-off-by: Abin Joseph <abin.joseph@amd.com>
Reviewed-by: Radhey Shyam Pandey <radhey.shyam.pandey@amd.com>
Message-ID: <20250816020947.479246-3-abin.joseph@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/net/ethernet/xilinx/xilinx_axienet_main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
index 750474938209..f02194c02ebc 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
@@ -5106,7 +5106,7 @@ static int axienet_probe(struct platform_device *pdev)
 		ret = of_property_read_string(pdev->dev.of_node,
 					      "xlnx,gt-mode",
 					      &gt_mode);
-		if (ret != -EINVAL && !strcasecmp(gt_mode, GT_MODE_NARROW))
+		if (ret == 0 && !strcasecmp(gt_mode, GT_MODE_NARROW))
 			lp->gt_mode_narrow = true;
 
 		/* Default AXI4-stream data widths */
-- 
2.43.0

