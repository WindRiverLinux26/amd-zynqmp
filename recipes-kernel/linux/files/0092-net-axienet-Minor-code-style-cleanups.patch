From 559ee42ef2c5dda740e82a2318542383913a8086 Mon Sep 17 00:00:00 2001
From: Suraj Gupta <suraj.gupta2@amd.com>
Date: Wed, 10 Sep 2025 19:27:32 +0530
Subject: [PATCH 092/190] net: axienet: Minor code style cleanups

commit 6665f65244aa51f387a19c95b603fd781faec43f from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Fix below minor code style issues:

1. Remove unnecessary braces around single statement in if condition
   for axienet_skb_tstsmp() call in axienet_queue_xmit()

2. Remove trailing blank line after netif_napi_add() calls in
   axienet_dma_probe()

Signed-off-by: Suraj Gupta <suraj.gupta2@amd.com>
Message-ID: <20250910135732.2956539-1-suraj.gupta2@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/net/ethernet/xilinx/xilinx_axienet_main.c | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
index e2f16fe8653d..04d8022cde6e 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
@@ -1958,9 +1958,8 @@ static int axienet_queue_xmit(struct sk_buff *skb,
 	}
 
 #ifdef CONFIG_XILINX_AXI_EMAC_HWTSTAMP
-	if (axienet_skb_tstsmp(&skb, q, ndev)) {
+	if (axienet_skb_tstsmp(&skb, q, ndev))
 		return NETDEV_TX_BUSY;
-	}
 #endif
 
 	if (skb->ip_summed == CHECKSUM_PARTIAL && !lp->eth_hasnobuf &&
@@ -4190,7 +4189,6 @@ static int __maybe_unused axienet_dma_probe(struct platform_device *pdev,
 		}
 		netif_napi_add(ndev, &q->napi_tx, axienet_tx_poll);
 		netif_napi_add(ndev, &q->napi_rx, xaxienet_rx_poll);
-
 	}
 
 	of_node_put(np);
-- 
