From 0350d26fe9443263bb5cf6bfb2900c651503b0aa Mon Sep 17 00:00:00 2001
From: Anatoliy Klymenko <anatoliy.klymenko@amd.com>
Date: Fri, 17 Oct 2025 15:55:27 -0700
Subject: [PATCH 174/190] drm: xlnx: mixer: Add connect_drm_bridge flag

commit e0b55ce82083dba70fb0ab0cc742a2827d15c74a from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Add connect_drm_bridge module parameter that enables discovery and use of
downstream DRM bridge. DRM framework and AMD DRM PL drivers use the same
device tree port connection mechanism for 2 different purposes. DRM
framework uses such connections to build DRM bridge chains and connect
them to the CRTC. AMD DRM PL drivers traverse connected nodes to build up
component list within the aggregate driver. This creates ambiguity for PL
component drivers supporting DRM bridge connections. Current change
provides the resolution for such ambiguity via explicit module flag. This
approach has some limitations, for instance it won't work for PL designs
with multiple video mixer instances connected to PS DP (via DRM bridge
interface) and PL SDI (via old style DRM encoder interface). This flag is
temporary and should be removed as soon as all DRM PL encoder / connector
drivers converted to DRM bridges.

Signed-off-by: Anatoliy Klymenko <anatoliy.klymenko@amd.com>
Reviewed-by: Vishal Sagar <vishal.sagar@amd.com>
Message-ID: <20251017225527.3662637-3-anatoliy.klymenko@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/gpu/drm/xlnx/xlnx_mixer.c | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/xlnx/xlnx_mixer.c b/drivers/gpu/drm/xlnx/xlnx_mixer.c
index c08b874d2400..1e0a129dc033 100644
--- a/drivers/gpu/drm/xlnx/xlnx_mixer.c
+++ b/drivers/gpu/drm/xlnx/xlnx_mixer.c
@@ -26,6 +26,7 @@
 #include <linux/component.h>
 #include <linux/dma/xilinx_frmbuf.h>
 #include <linux/media-bus-format.h>
+#include <linux/moduleparam.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/gpio/consumer.h>
 #include <linux/of.h>
@@ -257,6 +258,11 @@ static bool xlnx_mixer_primary_enable = true;
 module_param_named(mixer_primary_enable, xlnx_mixer_primary_enable, bool, 0600);
 MODULE_PARM_DESC(mixer_primary_enable, "Enable mixer primary plane (default: 1)");
 
+/* TODO: remove this when all PL encoder drivers converted to DRM bridges */
+static bool connect_drm_bridge;
+module_param(connect_drm_bridge, bool, 0600);
+MODULE_PARM_DESC(connect_drm_bridge, "Use DRM bridge interface");
+
 /*********************** Inline Functions/Macros *****************************/
 #define to_mixer_hw(p) (&((p)->mixer->mixer_hw))
 #define to_xlnx_crtc(x)	container_of(x, struct xlnx_crtc, crtc)
@@ -2373,14 +2379,16 @@ static int xlnx_mix_dt_dp_bridge(struct device *dev, struct xlnx_mix *mixer)
 	struct drm_bridge *bridge;
 
 	/* First check if we have drm bridge connected */
-	bridge = devm_drm_of_get_bridge(dev, dev->of_node, 0, 0);
-	if (IS_ERR(bridge)) {
-		if (PTR_ERR(bridge) == -EPROBE_DEFER)
-			return PTR_ERR(bridge);
-		/* Ignore other errors and fall back to xlnx bridge */
-	} else {
-		mixer->drm_bridge = bridge;
-		return 0;
+	if (connect_drm_bridge) {
+		bridge = devm_drm_of_get_bridge(dev, dev->of_node, 0, 0);
+		if (IS_ERR(bridge)) {
+			if (PTR_ERR(bridge) == -EPROBE_DEFER)
+				return PTR_ERR(bridge);
+			/* Ignore other errors and fall back to xlnx bridge */
+		} else {
+			mixer->drm_bridge = bridge;
+			return 0;
+		}
 	}
 
 	node = dev->of_node;
-- 
