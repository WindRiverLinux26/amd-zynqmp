From 4b9a8f05c61885f1e5ba0634ebea16f9eb2d2f57 Mon Sep 17 00:00:00 2001
From: Vineeth Karumanchi <vineeth.karumanchi@amd.com>
Date: Thu, 21 Aug 2025 15:15:03 +0530
Subject: [PATCH 043/190] net: macb: Add support for 2.5GBASE-X interface mode

commit 86b23b5041cb51fe16f193afa6f5f7e9d804265c from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Add handling for PHY_INTERFACE_MODE_2500BASEX. This includes:

- Defining GEM_2PT5_G bit in macb.h for NCR register.
- Setting PCSSEL and GEM_2PT5_G bits in macb_mac_config() when
  2500BASE-X is selected.
- Updating PCS control logic to include 2500BASE-X.
- Extending PCS selection to return phylink_usx_pcs for 2500BASE-X.

This enables MAC configuration for 2.5GBASE-X links on GEM-based MACs.

Link: https://lore.kernel.org/netdev/20241009053946.3198805-1-vineeth.karumanchi@amd.com/
Signed-off-by: Vineeth Karumanchi <vineeth.karumanchi@amd.com>
Reviewed-by: Harini Katakam <harini.katakam@amd.com>
Message-ID: <20250821094503.4138511-1-vineeth.karumanchi@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/net/ethernet/cadence/macb.h      | 2 ++
 drivers/net/ethernet/cadence/macb_main.c | 7 ++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/cadence/macb.h b/drivers/net/ethernet/cadence/macb.h
index c38d2e91ed07..8ee7c238cc79 100644
--- a/drivers/net/ethernet/cadence/macb.h
+++ b/drivers/net/ethernet/cadence/macb.h
@@ -313,6 +313,8 @@
 /* GEM specific NCR bitfields. */
 #define GEM_ENABLE_HS_MAC_OFFSET	31
 #define GEM_ENABLE_HS_MAC_SIZE		1
+#define GEM_2PT5_G_OFFSET	29
+#define GEM_2PT5_G_SIZE		1
 
 /* GEM specific NCFGR bitfields. */
 #define GEM_FD_OFFSET		1 /* Full duplex */
diff --git a/drivers/net/ethernet/cadence/macb_main.c b/drivers/net/ethernet/cadence/macb_main.c
index 0122963e1606..234a8716f962 100644
--- a/drivers/net/ethernet/cadence/macb_main.c
+++ b/drivers/net/ethernet/cadence/macb_main.c
@@ -711,6 +711,9 @@ static void macb_mac_config(struct phylink_config *config, unsigned int mode,
 			ctrl |= GEM_BIT(SGMIIEN) | GEM_BIT(PCSSEL);
 		} else if (state->interface == PHY_INTERFACE_MODE_1000BASEX) {
 			ctrl |= GEM_BIT(PCSSEL);
+		} else if (state->interface == PHY_INTERFACE_MODE_2500BASEX) {
+			ctrl |= GEM_BIT(PCSSEL);
+			ncr |= GEM_BIT(2PT5_G);
 		} else if (state->interface == PHY_INTERFACE_MODE_10GBASER) {
 			ctrl |= GEM_BIT(PCSSEL);
 			ncr |= GEM_BIT(ENABLE_HS_MAC);
@@ -732,7 +735,8 @@ static void macb_mac_config(struct phylink_config *config, unsigned int mode,
 	 * otherwise writes will not take effect.
 	 */
 	if (macb_is_gem(bp) && (state->interface == PHY_INTERFACE_MODE_SGMII ||
-				state->interface == PHY_INTERFACE_MODE_1000BASEX)) {
+				state->interface == PHY_INTERFACE_MODE_1000BASEX ||
+				state->interface == PHY_INTERFACE_MODE_2500BASEX)) {
 		u32 pcsctrl, old_pcsctrl;
 
 		old_pcsctrl = gem_readl(bp, PCSCNTRL);
@@ -840,6 +844,7 @@ static struct phylink_pcs *macb_mac_select_pcs(struct phylink_config *config,
 	struct macb *bp = netdev_priv(ndev);
 
 	if (interface == PHY_INTERFACE_MODE_10GBASER ||
+	    interface == PHY_INTERFACE_MODE_2500BASEX ||
 	    interface == PHY_INTERFACE_MODE_1000BASEX)
 		return &bp->phylink_usx_pcs;
 	else if (interface == PHY_INTERFACE_MODE_SGMII)
