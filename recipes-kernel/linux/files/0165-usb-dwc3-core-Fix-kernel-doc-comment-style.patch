Date: Thu, 9 Oct 2025 12:48:10 +0530
Subject: [PATCH 165/190] usb: dwc3: core: Fix kernel-doc comment style

commit a57335b86eea6bfb31748554dd4964062a2f20d7 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Corrects kernel-doc comment style in core header.
- Adds missing description for dwc3_pmu
- Fixes indentation for force_hiber_wake

Signed-off-by: Radhey Shyam Pandey <radhey.shyam.pandey@amd.com>
Message-ID: <20251009071811.1574563-3-radhey.shyam.pandey@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/usb/dwc3/core.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index 019373a2c5fb..a5585ffccc0d 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1068,6 +1068,7 @@ struct dwc3_scratchpad_array {
  * @hsphy_mode: UTMI phy mode, one of following:
  *		- USBPHY_INTERFACE_MODE_UTMI
  *		- USBPHY_INTERFACE_MODE_UTMIW
+ * @dwc3_pmu: acquire and control power management unit(PMU) regulator
  * @role_sw: usb_role_switch handle
  * @role_switch_default_mode: default operation mode of controller while
  *			usb role is USB_ROLE_NONE.
@@ -1200,7 +1201,7 @@ struct dwc3_scratchpad_array {
  * @irq_wakeup: wakeup IRQ number, triggered when host asks to wakeup from
  *              hibernation
  * @force_hiber_wake: flag set when the gadget driver is forcefully triggering
-		a hibernation wakeup event
+ *		a hibernation wakeup event
  */
 struct dwc3 {
 	struct work_struct	drd_work;
