Date: Thu, 11 Sep 2025 10:52:48 +0530
Subject: [PATCH 093/190] dt-bindings: net: xlnx,axi-ethernet: Rename DCMAC
 gpio properties name

commit 55d2f1abca2f98cd1b05bc16b0f780e4390c8a82 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

DCMAC gpio properties name are renamed by replacing  "_" with "-",
because "_" is not allowed in node and property names.

Signed-off-by: Ravikanth Tuniki <ravikanth.tuniki@amd.com>
Reviewed-by: Harini Katakam <harini.katakam@amd.com>
Message-ID: <20250911052251.10925-2-ravikanth.tuniki@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 .../bindings/net/xlnx,axi-ethernet.yaml       | 54 ++++++++++++-------
 1 file changed, 36 insertions(+), 18 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/xlnx,axi-ethernet.yaml b/Documentation/devicetree/bindings/net/xlnx,axi-ethernet.yaml
index 49bceb201315..e5ec4185bb72 100644
--- a/Documentation/devicetree/bindings/net/xlnx,axi-ethernet.yaml
+++ b/Documentation/devicetree/bindings/net/xlnx,axi-ethernet.yaml
@@ -242,26 +242,44 @@ properties:
   max-speed: true
 
   gt_ctrl-gpios:
+    deprecated: true
+
+  gt-ctrl-gpios:
     description: Phandle and specifier for GT control GPIO used to
       configure GT.
 
   gt_rx_dpath-gpios:
+    deprecated: true
+
+  gt-rx-dpath-gpios:
     description: Phandle and specifier for the GPIO used to
       reset GT Rx datapath.
 
   gt_tx_dpath-gpios:
+    deprecated: true
+
+  gt-tx-dpath-gpios:
     description: Phandle and specifier for the GPIO used to
       reset GT Tx datapath.
 
   gt_tx_rst_done-gpios:
+    deprecated: true
+
+  gt-tx-rst-done-gpios:
     description: Phandle and specifier for the GPIO used to
       get GT Tx reset status.
 
   gt_rx_rst_done-gpios:
+    deprecated: true
+
+  gt-rx-rst-done-gpios:
     description: Phandle and specifier for the GPIO used to
       get GT Rx reset status.
 
   gt_rsts-gpios:
+    deprecated: true
+
+  gt-rsts-gpios:
     description: Phandle and specifier for the GPIO used to
       reset Tx and Rx serdes.
 
@@ -405,32 +423,32 @@ allOf:
         max-speed:
           enum: [100000, 200000, 400000]
 
-        gt_ctrl-gpios:
+        gt-ctrl-gpios:
           maxItems: 32
 
-        gt_rx_dpath-gpios:
+        gt-rx-dpath-gpios:
           maxItems: 23
 
-        gt_tx_dpath-gpios:
+        gt-tx-dpath-gpios:
           maxItems: 23
 
-        gt_tx_rst_done-gpios:
+        gt-tx-rst-done-gpios:
           maxItems: 24
 
-        gt_rx_rst_done-gpios:
+        gt-rx-rst-done-gpios:
           maxItems: 24
 
-        gt_rsts-gpios:
+        gt-rsts-gpios:
           maxItems: 14
 
       required:
         - max-speed
-        - gt_ctrl-gpios
-        - gt_rx_dpath-gpios
-        - gt_tx_dpath-gpios
-        - gt_tx_rst_done-gpios
-        - gt_rx_rst_done-gpios
-        - gt_rsts-gpios
+        - gt-ctrl-gpios
+        - gt-rx-dpath-gpios
+        - gt-tx-dpath-gpios
+        - gt-tx-rst-done-gpios
+        - gt-rx-rst-done-gpios
+        - gt-rsts-gpios
 
 additionalProperties: false
 
@@ -545,36 +563,36 @@ examples:
         xlnx,rxmem = <0x8000>;
         max-speed = <100000>;
 
