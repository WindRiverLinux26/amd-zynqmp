+++ b/Documentation/devicetree/bindings/iio/adc/xlnx,versal-sysmon.yaml
@@ -90,6 +90,7 @@ patternProperties:
       - xlnx,name
 
     additionalProperties: false
+
   "^temp@([1-9]|[1-5][0-9]|6[0-4])$":
     type: object
     description:
@@ -117,6 +118,8 @@ patternProperties:
       - reg
       - xlnx,name
 
+    additionalProperties: false
+
 required:
   - compatible
   - reg
