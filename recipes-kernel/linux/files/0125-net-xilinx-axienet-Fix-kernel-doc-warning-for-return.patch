From bd8ccb343caabee6e5e3720e5750ff30f19c677a Mon Sep 17 00:00:00 2001
From: Suraj Gupta <suraj.gupta2@amd.com>
Date: Tue, 23 Sep 2025 12:22:21 +0530
Subject: [PATCH 125/190] net: xilinx: axienet: Fix kernel-doc warning for
 return description

commit dbc2a26cd657fa379c001fff967d705898b152e4 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Standardize the return documentation format for axienet_free_tx_chain()
by replacing inline "Returns" text with proper "Return:" tags as per
kernel documentation guidelines.

Fixes below kernel-doc warning:
 Warning: No description found for return value of 'axienet_free_tx_chain'

Signed-off-by: Suraj Gupta <suraj.gupta2@amd.com>
Link: https://patch.msgid.link/20250919103754.434711-1-suraj.gupta2@amd.com
Signed-off-by: Jakub Kicinski <kuba@kernel.org>
State: upstream (312e6a58f764)
Message-ID: <20250923065221.881809-1-suraj.gupta2@amd.com>
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/net/ethernet/xilinx/xilinx_axienet_main.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
index b35ff2e20be7..fcd6b097d805 100644
--- a/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet_main.c
@@ -1180,15 +1180,14 @@ void axienet_dma_stop(struct axienet_dma_q *dq)
  * axienet_device_reset - Reset and initialize the Axi Ethernet hardware.
  * @ndev:	Pointer to the net_device structure
  *
- * Return: 0 on success, Negative value on errors
- *
  * This function is called to reset and initialize the Axi Ethernet core. This
  * is typically called during initialization. It does a reset of the Axi DMA
  * Rx/Tx channels and initializes the Axi DMA BDs. Since Axi DMA reset lines
  * are connected to Axi Ethernet reset lines, this in turn resets the Axi
  * Ethernet core. No separate hardware reset is done for the Axi Ethernet
  * core.
- * Returns 0 on success or a negative error number otherwise.
+ *
+ * Return: 0 on success or a negative error number otherwise.
  */
 static int axienet_device_reset(struct net_device *ndev)
 {
@@ -1527,7 +1526,8 @@ static void axienet_rx_hwtstamp(struct axienet_local *lp,
  *
  * Would either be called after a successful transmit operation, or after
  * there was an error when setting up the chain.
- * Returns the number of packets handled.
+ *
+ * Return: The number of packets handled.
  */
 
 static int axienet_free_tx_chain(struct axienet_dma_q *q, u32 first_bd,
