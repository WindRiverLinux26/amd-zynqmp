From b4a6f2aada14ee63bfa4df5625a638ed289d3cf5 Mon Sep 17 00:00:00 2001
From: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Date: Thu, 2 Oct 2025 20:11:55 -0700
Subject: [PATCH 148/190] xilinx-ai-engine: add tracepoint for partition
 request done

commit fee332f45a91e6a71f8a9a05824a040a02b015b5 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Add tracepoint for aie_partition_request done.

Signed-off-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Acked-by: Gregory Williams <gregory.williams@amd.com>
Message-ID: <20251003031202.2319372-9-govindarajulu.varadarajan@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/misc/xilinx-ai-engine/ai-engine-dev.c |  1 +
 .../misc/xilinx-ai-engine/ai-engine-trace.h   | 24 +++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-dev.c b/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
index a52866454c11..89da2d137f23 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
@@ -818,6 +818,7 @@ struct device *aie_partition_request(struct aie_partition_req *req)
 	}
 	apart->user_event1_complete = req->user_event1_complete;
 	apart->user_event1_priv = req->user_event1_priv;
+	trace_aie_partition_request_done(req);
 
 	return &apart->dev;
 }
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
index 0e531bd087de..945b5bf3a4fe 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-trace.h
@@ -656,6 +656,30 @@ TRACE_EVENT(aie_partition_request,
 		  __entry->uid, __entry->meta_data, __entry->flag)
 );
 
+TRACE_EVENT(aie_partition_request_done,
+	TP_PROTO(struct aie_partition_req *req),
+	TP_ARGS(req),
+	TP_STRUCT__entry(
+		__field(__u32, partition_id)
+		__field(__u32, start_col)
+		__field(__u32, num_cols)
+		__field(__u32, uid)
+		__field(__u64, meta_data)
+		__field(__u32, flag)
+	),
+	TP_fast_assign(
+		__entry->partition_id = req->partition_id;
+		__entry->start_col = aie_part_id_get_start_col(req->partition_id);
+		__entry->num_cols = aie_part_id_get_num_cols(req->partition_id);
+		__entry->uid = req->uid;
+		__entry->meta_data = req->meta_data;
+		__entry->flag = req->flag;
+	),
+	TP_printk("id: %d start_col: %d num_cols: %d uid: %d meta_data: 0x%llx flag: 0x%x",
+		  __entry->partition_id, __entry->start_col, __entry->num_cols,
+		  __entry->uid, __entry->meta_data, __entry->flag)
+);
+
 TRACE_EVENT(aie_partition_is_available,
 	TP_PROTO(struct aie_partition_req *req),
 	TP_ARGS(req),
-- 
