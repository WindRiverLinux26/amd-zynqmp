From: Sai Krishna Musham <sai.krishna.musham@amd.com>
Date: Fri, 15 Aug 2025 14:24:59 +0530
Subject: [PATCH 036/190] Revert "dt-bindings: PCI: amd-mdb: Add reset-gpios
 example to handle PCIe RP PERST#"

commit e6946dbb7079f2ea1dec86c56e811c764d074337 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

This reverts commit 85e87a9376956ff6afecac0b13d08d7490af64a1.
The patch to add reset-gpios example in dt-binding to support PCIe RP PERST# has
been merged into mainline. This revert is to align with the upstream state.

Signed-off-by: Sai Krishna Musham <sai.krishna.musham@amd.com>
Message-ID: <20250815085503.791277-2-sai.krishna.musham@amd.com>
State: not-upstreamable
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 Documentation/devicetree/bindings/pci/amd,versal2-mdb-host.yaml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/amd,versal2-mdb-host.yaml b/Documentation/devicetree/bindings/pci/amd,versal2-mdb-host.yaml
index 39066be0a818..db751a51e63c 100644
--- a/Documentation/devicetree/bindings/pci/amd,versal2-mdb-host.yaml
+++ b/Documentation/devicetree/bindings/pci/amd,versal2-mdb-host.yaml
@@ -87,7 +87,6 @@ examples:
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
     #include <dt-bindings/interrupt-controller/irq.h>
-    #include <dt-bindings/gpio/gpio.h>
 
     soc {
         #address-cells = <2>;
@@ -113,7 +112,6 @@ examples:
             #size-cells = <2>;
             #interrupt-cells = <1>;
             device_type = "pci";
-            reset-gpios = <&tca6416_u37 7 GPIO_ACTIVE_LOW>;
             pcie_intc_0: interrupt-controller {
                 #address-cells = <0>;
                 #interrupt-cells = <1>;
