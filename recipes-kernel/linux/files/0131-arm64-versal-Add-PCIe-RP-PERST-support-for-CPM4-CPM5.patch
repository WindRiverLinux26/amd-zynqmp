index bb997a8ce107..300d83cc91b1 100644
--- a/arch/arm64/boot/dts/xilinx/versal-vpk120-revB.dts
+++ b/arch/arm64/boot/dts/xilinx/versal-vpk120-revB.dts
@@ -106,7 +106,9 @@ eeprom: eeprom@54 { /* u34 - m24128 16kB */
 	};
 };
 
-/* PCIe at MIO 38/39/40/50 */
+&cpm5_pcie { /* PCIe at MIO 38/39/40/50 */
+	reset-gpios = <&gpio1 38 GPIO_ACTIVE_LOW>;
+};
 
 &gem0 { /* PMC_MIO_48 - reset, LPD_MIO0-11 , mdio LPD_MIO24/25 */
 	status = "okay";
