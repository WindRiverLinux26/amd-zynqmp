From 1a5d33484cbfccad0bfcfa5c0b44239e5da222d2 Mon Sep 17 00:00:00 2001
From: Sai Krishna Musham <sai.krishna.musham@amd.com>
Date: Wed, 10 Sep 2025 12:30:45 +0530
Subject: [PATCH 131/190] arm64: versal: Add PCIe RP PERST# support for CPM4,
 CPM5 and Rhino

commit 43522cedd235baf5b0c8797b7be99c6065c31ac9 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Update reg property for CPM4 and CPM5 controller 0 and add reset-gpios
property for VMK180 and VPK120 to enable PCIe Root Port (RP) PERST#
support.

Add PCIe Root Port PERST# support for Rhino Board.

Correct Bridge registers address size for CPM5 controller 0 and Rhino
board.

Keep CPM PCIe nodes disabled in base versal.dtsi for VMK180 and VPK120
boards: some designs omit the PCIe block and ECAM access would
hang the system if status were forced to "okay". Boards that
instantiate the block enable it locally.

Remove unevaluated properties to align with dt binding.

Signed-off-by: Sai Krishna Musham <sai.krishna.musham@amd.com>
Message-ID: <20250910070045.3655610-1-sai.krishna.musham@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 arch/arm64/boot/dts/xilinx/versal-vmk180-revA.dts |  3 +++
 arch/arm64/boot/dts/xilinx/versal-vpk120-revA.dts |  4 +++-
 arch/arm64/boot/dts/xilinx/versal-vpk120-revB.dts |  4 +++-
 arch/arm64/boot/dts/xilinx/versal.dtsi            | 12 ++++++------
 4 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/xilinx/versal-vmk180-revA.dts b/arch/arm64/boot/dts/xilinx/versal-vmk180-revA.dts
index 4c81b164acc5..30e2f1b6cd51 100644
--- a/arch/arm64/boot/dts/xilinx/versal-vmk180-revA.dts
+++ b/arch/arm64/boot/dts/xilinx/versal-vmk180-revA.dts
@@ -41,6 +41,9 @@ aliases {
 
 /* PMC_MIO 0 -12 - configuration header QSPI/OSPI/EMMC */
 /* FIXME PMC_MIO37 ZU4_TRIGGER/PMC_MIO37/38 PCIE */
+&cpm_pciea {
+	reset-gpios = <&gpio1 38 GPIO_ACTIVE_LOW>;
+};
 
 &can1 { /* MIO40-41 */
 	status = "okay";
diff --git a/arch/arm64/boot/dts/xilinx/versal-vpk120-revA.dts b/arch/arm64/boot/dts/xilinx/versal-vpk120-revA.dts
