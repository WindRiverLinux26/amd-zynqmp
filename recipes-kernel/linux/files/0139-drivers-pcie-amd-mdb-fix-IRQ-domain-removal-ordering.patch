From 27f4092e08ce1a9e00acd36ff71ee771960fafc6 Mon Sep 17 00:00:00 2001
From: Luca Miccio <luca.miccio@amd.com>
Date: Thu, 25 Sep 2025 13:43:48 -0700
Subject: [PATCH 139/190] drivers/pcie-amd-mdb: fix IRQ domain removal ordering
 to avoid null dereferences

commit 0c93363240b22749af89433d9ce67411a4e04c14 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Currently, amd_mdb_pcie_free_irq_domains() is called on error paths,
either after host initialization failure or IRQ domain setup failure.

In the latter case (IRQ domain init failure), it is safe to simply
remove the domain since no IRQ mappings or requests have occurred.

However, in the former case (host init failure), IRQ mappings may have
been created and IRQs requested via devm_request_irq(). If the IRQ
domain is removed before the device-managed resources are released,
Linux may attempt to clean up IRQs that no longer have valid domain
associations, leading to null pointer dereferences during IRQ teardown.

This issue is particularly visible in Xen environments where the guest
is assigned only a single vCPU. In such configurations, IRQ teardown
may be delayed or serialized differently, exposing the incorrect
ordering between IRQ domain removal and resource release.

This patch ensures that IRQ mappings are properly disposed only after
the IRQs have been freed, and that domain removal happens after all
associated resources are released.

Signed-off-by: Luca Miccio <luca.miccio@amd.com>
Tested-by: Stefano Stabellini <stefano.stabellini@amd.com>
Message-ID: <20250925204348.3866245-1-luca.miccio@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/pci/controller/dwc/pcie-amd-mdb.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/pci/controller/dwc/pcie-amd-mdb.c b/drivers/pci/controller/dwc/pcie-amd-mdb.c
index 28faab4249c3..aa8483867f5d 100644
--- a/drivers/pci/controller/dwc/pcie-amd-mdb.c
+++ b/drivers/pci/controller/dwc/pcie-amd-mdb.c
@@ -245,6 +245,25 @@ static void amd_mdb_pcie_free_irq_domains(struct amd_mdb_pcie *pcie)
 	}
 
 	if (pcie->mdb_domain) {
+		int i, irq;
+
+		for (i = 0; i < ARRAY_SIZE(intr_cause); i++) {
+			if (!intr_cause[i].str)
+				continue;
+			irq = irq_find_mapping(pcie->mdb_domain, i);
+			if (irq) {
+				disable_irq(irq);
+				free_irq(irq,pcie);
+				irq_dispose_mapping(irq);
+			}
+		}
+		irq = irq_find_mapping(pcie->mdb_domain, AMD_MDB_PCIE_INTR_INTX);
+		if (irq) {
+			disable_irq(irq);
+			free_irq(irq, pcie);
+			irq_dispose_mapping(irq);
+		}
+
 		irq_domain_remove(pcie->mdb_domain);
 		pcie->mdb_domain = NULL;
 	}
