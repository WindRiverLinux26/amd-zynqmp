From e0095787aaf69c28b9cd1134a6a288f7212cb8de Mon Sep 17 00:00:00 2001
From: Amit Kumar Mahapatra <amit.kumar-mahapatra@amd.com>
Date: Thu, 9 Oct 2025 16:54:11 +0530
Subject: [PATCH 168/190] mtd: spi-nor: Validate SDR-PHY mode switch by reading
 flash ID in stacked mode

commit 744c629ecd393a1bf4969265b2857b3e63d91a41 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

In stacked mode, after switching to SDR-PHY, read the flash ID and compare
it against the expected (golden) flash ID to confirm that the transition to
SDR-PHY mode was successful.

Fixes: 9e279cdc5680 ("mtd: spi-nor: Add SDR-PHY support for OSPI flashes")
Signed-off-by: Amit Kumar Mahapatra <amit.kumar-mahapatra@amd.com>
Message-ID: <20251009112411.3261192-3-amit.kumar-mahapatra@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 drivers/mtd/spi-nor/gigadevice.c | 3 ---
 drivers/mtd/spi-nor/issi.c       | 3 ---
 drivers/mtd/spi-nor/macronix.c   | 3 ---
 drivers/mtd/spi-nor/micron-st.c  | 3 ---
 4 files changed, 12 deletions(-)

diff --git a/drivers/mtd/spi-nor/gigadevice.c b/drivers/mtd/spi-nor/gigadevice.c
index 910c45f72c90..c9e5b8c813d7 100644
--- a/drivers/mtd/spi-nor/gigadevice.c
+++ b/drivers/mtd/spi-nor/gigadevice.c
@@ -40,9 +40,6 @@ static int spi_nor_gigadevice_phy_enable(struct spi_nor *nor)
 	if (ret)
 		goto ret;
 
-	if ((nor->flags & SNOR_F_HAS_STACKED) && nor->spimem->spi->cs_index_mask == 1)
-		return 0;
-
 	nor->spimem->spi->controller->flags |= SPI_CONTROLLER_SDR_PHY;
 	/* Read flash ID to make sure the switch was successful. */
 	op = (struct spi_mem_op)
diff --git a/drivers/mtd/spi-nor/issi.c b/drivers/mtd/spi-nor/issi.c
index b90b1e6ec0c7..111397af2f14 100644
--- a/drivers/mtd/spi-nor/issi.c
+++ b/drivers/mtd/spi-nor/issi.c
@@ -40,9 +40,6 @@ static int spi_nor_issi_phy_enable(struct spi_nor *nor)
 	if (ret)
 		goto ret;
 
-	if ((nor->flags & SNOR_F_HAS_STACKED) && nor->spimem->spi->cs_index_mask == 1)
-		return 0;
-
 	nor->spimem->spi->controller->flags |= SPI_CONTROLLER_SDR_PHY;
 	/* Read flash ID to make sure the switch was successful. */
 	op = (struct spi_mem_op)
diff --git a/drivers/mtd/spi-nor/macronix.c b/drivers/mtd/spi-nor/macronix.c
index 8897265faf9b..3cb61dc754ec 100644
--- a/drivers/mtd/spi-nor/macronix.c
+++ b/drivers/mtd/spi-nor/macronix.c
@@ -42,9 +42,6 @@ static int spi_nor_macronix_phy_enable(struct spi_nor *nor)
 	if (ret)
 		goto ret;
 
-	if ((nor->flags & SNOR_F_HAS_STACKED) && nor->spimem->spi->cs_index_mask == 1)
-		return 0;
-
 	nor->spimem->spi->controller->flags |= SPI_CONTROLLER_SDR_PHY;
 	/* Read flash ID to make sure the switch was successful. */
 	op = (struct spi_mem_op)
diff --git a/drivers/mtd/spi-nor/micron-st.c b/drivers/mtd/spi-nor/micron-st.c
index e6419a275296..e8b28b11453c 100644
--- a/drivers/mtd/spi-nor/micron-st.c
+++ b/drivers/mtd/spi-nor/micron-st.c
@@ -59,9 +59,6 @@ static int micron_st_nor_phy_enable(struct spi_nor *nor)
 	if (ret)
 		goto ret;
 
-	if ((nor->flags & SNOR_F_HAS_STACKED) && nor->spimem->spi->cs_index_mask == 1)
-		return 0;
-
 	nor->spimem->spi->controller->flags |= SPI_CONTROLLER_SDR_PHY;
 	/* Read flash ID to make sure the switch was successful. */
 	ret = spi_nor_read_id(nor, 0, 0, buf, SNOR_PROTO_1_1_1);
-- 
