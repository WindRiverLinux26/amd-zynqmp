From 4fa3d85f9a0e6bc226db53c74e169d7c5bf6e309 Mon Sep 17 00:00:00 2001
From: Sankarji Gopalakrishnan <sankarji@amd.com>
Date: Thu, 23 Oct 2025 20:59:24 -0700
Subject: [PATCH 178/190] xilinx-ai-engine: Scale back the aie freq to MAX

commit 09a0c052ddaf1238ebdb5c66cd28faef28383be3 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

PM driver reduces the frequency, so have to scale back on probe

Signed-off-by: Sankarji Gopalakrishnan <sankarji@amd.com>
Acked-by: Govindarajulu Varadarajan <govindarajulu.varadarajan@amd.com>
Message-ID: <20251024035924.4009002-1-sankarji@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 .../misc/xilinx-ai-engine/ai-engine-clock.c   | 34 +++++++++++++++++++
 drivers/misc/xilinx-ai-engine/ai-engine-dev.c |  2 ++
 .../xilinx-ai-engine/ai-engine-internal.h     |  1 +
 3 files changed, 37 insertions(+)

diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-clock.c b/drivers/misc/xilinx-ai-engine/ai-engine-clock.c
index 5e3fe9216eb5..415d2edc6c9f 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-clock.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-clock.c
@@ -450,6 +450,40 @@ static unsigned long aie_aperture_get_freq_req(struct aie_aperture *aperture)
 	return freq_req;
 }
 
+/**
+ * aie_init_freq() - set frequency requirement of an AI engine
+ *
+ * @aperture: AI engine aperture
+ * @return: 0 for success, negative value for failure
+ *
+ * This sets the frequency to the boot time frequency.
+ * as PM drivers resets it during the power on sequence.
+ */
+int aie_init_freq(struct aie_aperture *aperture)
+{
+	u32 boot_qos, current_qos;
+	int ret;
+
+	ret = zynqmp_pm_get_qos(aperture->node_id, &boot_qos, &current_qos);
+	if (ret < 0) {
+		dev_err(&aperture->dev, "Failed to get clock divider value.\n");
+		return -EINVAL;
+	}
+
+	dev_err(&aperture->dev, "current_freq_divider[%x] boot_freq_divider[%x]\n",
+		current_qos, boot_qos);
+
+	ret = zynqmp_pm_set_requirement(aperture->node_id,
+					ZYNQMP_PM_CAPABILITY_ACCESS, boot_qos,
+					ZYNQMP_PM_REQUEST_ACK_BLOCKING);
+	if (ret < 0) {
+		dev_err(&aperture->dev, "Failed to set frequency requirement.\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 /**
  * aie_part_set_freq() - set frequency requirement of an AI engine partition
  *
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-dev.c b/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
index 383c0a3a8209..ccedcf158a9c 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-dev.c
@@ -481,6 +481,8 @@ void of_xilinx_ai_engine_aperture_probe(struct aie_device *adev)
 		}
 		list_add_tail(&aperture->node, &adev->apertures);
 
+		aie_init_freq(aperture);
+
 		mutex_unlock(&adev->mlock);
 	}
 }
diff --git a/drivers/misc/xilinx-ai-engine/ai-engine-internal.h b/drivers/misc/xilinx-ai-engine/ai-engine-internal.h
index c48c565b79c1..362bfb68c4cc 100644
--- a/drivers/misc/xilinx-ai-engine/ai-engine-internal.h
+++ b/drivers/misc/xilinx-ai-engine/ai-engine-internal.h
@@ -1710,6 +1710,7 @@ bool aie_part_check_clk_enable_loc(struct aie_partition *apart,
 				   struct aie_location *loc);
 int aie_part_set_freq(struct aie_partition *apart, u64 freq);
 int aie_part_get_freq(struct aie_partition *apart, u64 *freq);
+int aie_init_freq(struct aie_aperture *aperture);
 
 int aie_part_request_tiles(struct aie_partition *apart, int num_tiles,
 			   struct aie_location *locs);
