From e89098871c2636a65980d3667a1ba3bf7d0d978a Mon Sep 17 00:00:00 2001
From: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Date: Fri, 25 Jul 2025 12:37:27 +0530
Subject: [PATCH 019/190] dt-bindings: media: xilinx: sdirxss: Add dynamic BPC
 flag

commit b2e240e25eaa90c05eecf00da0833c59c2c0c316 from
https://github.com/Xilinx/linux-xlnx.git xlnx_rebase_v6.12

Add support for dynamic bits-per-channel (BPC) configuration in the
SDI YAML binding. This enables the SDI subsystem to receive video
at different bit depths depending on system configuration and
runtime requirements.

The supported values are:
    - 0x1: 10-bit video. In a 12-bit or 10-bit system, this value
           configures the subsystem to receive 10-bit video.
    - 0x2: 12-bit video. In a 12-bit system, this value configures
           the subsystem to receive full 12-bit video.

Signed-off-by: Dhanunjanrao Katta <katta.dhanunjanrao@amd.com>
Reviewed-by: Vishal Sagar <vishal.sagar@amd.com>
Message-ID: <1753427248-14564-2-git-send-email-katta.dhanunjanrao@amd.com>
State: pending
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 .../devicetree/bindings/media/xilinx/xlnx,sdirxss.yaml       | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/media/xilinx/xlnx,sdirxss.yaml b/Documentation/devicetree/bindings/media/xilinx/xlnx,sdirxss.yaml
index 31c9e6a974a8..f073894cc6d9 100644
--- a/Documentation/devicetree/bindings/media/xilinx/xlnx,sdirxss.yaml
+++ b/Documentation/devicetree/bindings/media/xilinx/xlnx,sdirxss.yaml
@@ -54,6 +54,10 @@ properties:
     $ref: /schemas/types.yaml#/definitions/uint32
     enum: [10, 12]
 
+  xlnx,dyn-bpc:
+    description: Whether the Dynamic BPC feature is enabled or not in the design.
+    type: boolean
+
   xlnx,include-edh:
     description: Whether the EDH processor is enabled or not in the design.
     type: boolean
@@ -127,6 +131,7 @@ examples:
         clock-names = "s_axi_aclk", "sdi_rx_clk", "video_out_clk";
         interrupts = <0 89 4>;
         xlnx,bpp = <10>;
+        xlnx,dyn-bpc;
         xlnx,include-edh;
         xlnx,line-rate = "12G_SDI_8DS";
         ports {
