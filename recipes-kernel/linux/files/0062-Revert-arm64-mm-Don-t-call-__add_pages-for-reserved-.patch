Signed-off-by: Stewart Hildebrand <stewart.hildebrand@amd.com>
Message-ID: <20250822200308.852899-1-stewart.hildebrand@amd.com>
State: not-upstreamable
Signed-off-by: Quanyang Wang <quanyang.wang@windriver.com>
Upstream-Status: Pending
---
 arch/arm64/mm/mmu.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/mm/mmu.c b/arch/arm64/mm/mmu.c
index 04ee137b2707..ea80e271301e 100644
--- a/arch/arm64/mm/mmu.c
+++ b/arch/arm64/mm/mmu.c
@@ -1359,12 +1359,8 @@ int arch_add_memory(int nid, u64 start, u64 size,
 
 	memblock_clear_nomap(start, size);
 
-	if (memblock_is_map_memory(start))
-		ret = __add_pages(nid, start >> PAGE_SHIFT, size >> PAGE_SHIFT,
-				  params);
-	else
-		ret = memblock_clear_nomap(start, size);
-
+	ret = __add_pages(nid, start >> PAGE_SHIFT, size >> PAGE_SHIFT,
+			   params);
 	if (ret)
 		__remove_pgd_mapping(swapper_pg_dir,
 				     __phys_to_virt(start), size);
